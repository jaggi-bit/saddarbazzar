# ===================================
# Sadar Bazar - Environment Variables
# ===================================
# Copy this file to .env and fill in the values

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=your-256-bit-secret-key-here
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL - Production) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sadarbazar
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# --- Redis (Production) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Payment Gateway (Generic) ---
# Set to your gateway's name (must match a registered PaymentGateway bean)
PAYMENT_GATEWAY_NAME=ONLINE
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# --- Logistics (Leopards) ---
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=
LEOPARDS_BASE_URL=https://merchantapi.leopardscourier.com/api

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sadarbazar.pk

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
